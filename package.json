{
  "name": "LyricsHunter",
  "version": "1.2.0",
  "private": true,
  "author": "Jose Pablo Brotons R <me@josepbrotons.com>",
  "scripts": {
    "android:build": "sh ./scripts/build_android.sh build_type:debug",
    "android:clean": "sh scripts/clean_android.sh",
    "build": "bash ./scripts/build.sh",
    "clean:rn": "sh scripts/clean_rn.sh",
    "clean:npm-modules": "sh scripts/clean_npm_modules.sh",
    "fix": "pnpm prettier",
    "ios:build": "sh ./scripts/build_ios.sh build_type:debug",
    "ios:clean": "sh ./scripts/clean_ios.sh",
    "ios:pod": "bundle install && cd ios && bundle exec pod install && cd ..",
    "ios:pod:reset": "bundle install && cd ios && rm -rf Pods Podfile.lock && bundle exec pod install && cd ..",
    "lint": "pnpm prettier-check",
    "prettier": "prettier --write \"./**/*.{ts,tsx}\"",
    "prettier-check": "prettier --check \"./**/*.{ts,tsx}\"",
    "start": "react-native start --reset-cache",
    "tsc": "tsc",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.*",
    "@react-native-community/netinfo": "12.0.*",
    "@react-native-masked-view/masked-view": "0.3.*",
    "@react-navigation/bottom-tabs": "7.16.*",
    "@react-navigation/native": "7.2.*",
    "@react-navigation/stack": "7.9.*",
    "i18n-js": "4.5.*",
    "lottie-react-native": "7.3.*",
    "react": "19.2.*",
    "react-native": "0.85.*",
    "react-native-bootsplash": "7.3.*",
    "react-native-config": "1.6.*",
    "react-native-gesture-handler": "2.31.*",
    "react-native-localize": "3.7.*",
    "react-native-reanimated": "4.3.*",
    "react-native-safe-area-context": "5.8.*",
    "react-native-screens": "4.25.*",
    "react-native-vector-icons": "10.3.*",
    "react-native-worklets": "0.8.*"
  },
  "devDependencies": {
    "@babel/core": "7.25.*",
    "@babel/preset-env": "7.25.*",
    "@babel/runtime": "7.25.*",
    "@react-native-community/cli": "20.1.*",
    "@react-native-community/cli-platform-android": "20.1.*",
    "@react-native-community/cli-platform-ios": "20.1.*",
    "@react-native/babel-preset": "0.85.*",
    "@react-native/eslint-config": "0.85.*",
    "@react-native/jest-preset": "0.85.*",
    "@react-native/metro-config": "0.85.*",
    "@react-native/typescript-config": "0.85.*",
    "@types/jest": "29.5.*",
    "@types/react": "19.2.*",
    "@types/react-native-vector-icons": "6.4.*",
    "@types/react-test-renderer": "19.1.*",
    "babel-jest": "29.6.*",
    "eslint": "8.19.*",
    "jest": "29.6.*",
    "prettier": "2.8.*",
    "react-native-asset": "2.3.*",
    "react-test-renderer": "19.2.*",
    "typescript": "5.8.*"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "setupFiles": [
      "./jest/setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(?:\\.pnpm/[^/]+/node_modules/)?(@react-native|react-native|@react-navigation|react-native-.*|@react-native-community|@react-native-masked-view))"
    ]
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "packageManager": "pnpm@11.6.0"
}
